            "children": [
              {
                "_key": "0ce638a30f590",
                "_type": "span",
                "marks": [],
                "text": "Docent is a radical new platform for art collectors to engage with contemporary art. Their mission is to bring a passionate expertise and a breadth of knowledge from across the contemporary art ecosystem together with the visionary research of leading scientists and thinkers in the realm of machine learning."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
