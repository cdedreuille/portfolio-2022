        "width": 8,
        "text": [
          {
            "_key": "335bc4691502",
            "_type": "block",
            "children": [
              {
                "_key": "3f511823ffa50",
                "_type": "span",
                "marks": [],
                "text": "Daisie is a social platform to help young creators connect with each other and build projects together. It is focused around ideas and storytelling with tools to share inspirations, prototypes and discuss creative projects."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "b01dbca1020e",
            "_type": "block",
            "children": [
              {
                "_key": "b30cdd636632",
                "_type": "span",
                "marks": [],
                "text": "I joined the team as the first designer, being responsible for the product design and research, from strategy to execution. We built the app and design system from the ground up for both mobile and web. This led to a launch with more than 22,000 sign ups on day one."
              }
            ],
            "markDefs": [],
            "style": "normal"
          }
